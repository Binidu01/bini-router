{
  "name": "bini-router",
  "version": "2.2.0",
  "description": "File-based routing, nested layouts, and API routes for Vite + React with MDX support",
  "author": "bini.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@remix-run/node-fetch-server": "^1.0.0",
    "magic-string": "^0.30.0",
    "oxc-parser": "^0.150.0",
    "oxc-walker": "^0.1.0",
    "react-error-boundary": "^4.0.0",
    "rou3": "^0.7.0",
    "tinyglobby": "^0.2.0",
    "unplugin-auto-import": "^0.19.0"
  },
  "peerDependencies": {
    "bini-env": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "bini-env": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-router-dom": {
      "optional": false
    },
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bini-env": "^1.1.2",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "bini",
    "bini.js",
    "react",
    "file-based-routing",
    "routing",
    "api-routes",
    "layouts",
    "metadata",
    "mdx",
    "markdown",
    "oxc",
    "react-19",
    "react-error-boundary",
    "rou3",
    "node-fetch-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binidu01/bini-router.git"
  },
  "homepage": "https://bini.js.org",
  "bugs": {
    "url": "https://github.com/Binidu01/bini-router/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}